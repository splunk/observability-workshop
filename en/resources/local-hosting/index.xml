<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Local Hosting on Splunk Observability Cloud Workshops</title><link>https://splunk.github.io/observability-workshop/en/resources/local-hosting/</link><description>Recent content in Local Hosting on Splunk Observability Cloud Workshops</description><generator>Hugo</generator><language>en</language><atom:link href="https://splunk.github.io/observability-workshop/en/resources/local-hosting/index.xml" rel="self" type="application/rss+xml"/><item><title>Multipass</title><link>https://splunk.github.io/observability-workshop/en/resources/local-hosting/multipass/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://splunk.github.io/observability-workshop/en/resources/local-hosting/multipass/</guid><description>&lt;p&gt;Install &lt;a href="https://multipass.run/" target="_blank" rel="noopener"&gt;Multipass&lt;svg class="link-ext" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"&gt;&lt;path d="M7 17 17 7"/&gt;&lt;path d="M9 7h8v8"/&gt;&lt;/svg&gt;&lt;/a&gt;
